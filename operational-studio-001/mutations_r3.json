{
 "about": "parse_v2.js に意図的な不具合を1つずつ入れ、固定した試験（cases_v2r3.json）が不合格を出すか確かめる一覧。find は parse_v2.js 内にちょうど1回現れる文字列、replace はその置き換え。mutation_runner_r3.html で再実行できる。 r3 で M-21・M-22（conflicts の余分）を追加。",
 "mutants": [
  {
   "id": "M-01",
   "name": "D1 の基準を2に",
   "find": "const MIN_DISTINCT_KEYS = 3;",
   "replace": "const MIN_DISTINCT_KEYS = 2;"
  },
  {
   "id": "M-02",
   "name": "複数の有効候補で最後を採用",
   "find": "if (valid.length >= 2) return failed('AMBIGUOUS_MULTIPLE_BLOCKS');",
   "replace": "if (valid.length >= 2) valid.splice(0, valid.length - 1);"
  },
  {
   "id": "M-03",
   "name": "見本判定 every→some",
   "find": "nonIdentity.every(k => c.placeholder[k])",
   "replace": "nonIdentity.some(k => c.placeholder[k])"
  },
  {
   "id": "M-04",
   "name": "閉じなし＋後続タグを無視",
