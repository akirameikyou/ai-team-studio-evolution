   "find": "const warnings = [], conflicts = [];",
   "replace": "const warnings = [], conflicts = ['CASE'];"
  },
  {
   "id": "M-22",
   "name": "同じ値の重複も conflict にする",
   "find": "if (dups[k].some(v => v !== fields[k])) conflicts.push(k);",
   "replace": "conflicts.push(k);"
  },
  {
   "id": "M-23",
   "name": "統合ブロックだけ余分な conflict（r2 の判定では見逃す型）",
   "find": "const warnings = [], conflicts = [];",
   "replace": "const warnings = [], conflicts = tag === 'STUDIO_SYNTHESIS' ? ['COMMON'] : [];"
  }
 ]
}