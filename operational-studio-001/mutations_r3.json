   "replace": ""
  },
  {
   "id": "M-05",
   "name": "行頭の重複検出を外す",
   "find": "if (!taken.has(keyPos(mk)) && hits.some(x => x.k === mk.k)) markers.push(mk);",
   "replace": ""
  },
  {
   "id": "M-06",
   "name": "値の食い違い判定を外す",
   "find": "if (dups[k].some(v => v !== fields[k])) conflicts.push(k);",
   "replace": ""
  },
  {
   "id": "M-07",
   "name": "分類未確定の警告を外す",
   "find": "if (labels.length) warnings.push('CLASSIFICATION_UNCERTAIN');",
   "replace": ""
  },
  {
   "id": "M-08",
   "name": "eligible が確認を無視",
   "find": "return requiredConfirmations(r, opts).every(x => done.has(x));",
   "replace": "return true;"
  },
  {
   "id": "M-09",
   "name": "SOURCE_ACCESS を部分一致に",
   "find": "return SOURCE_ACCESS_TEMPLATE.test(v);",
   "replace": "return v.includes('=DIRECT|');"
  },
  {
   "id": "M-10",
   "name": "閉じタグの位置条件を外す",
   "find": "const closed = !!c && (nextOpen < 0 || c.index < nextOpen);",
   "replace": "const closed = !!c;"
  },
  {
   "id": "M-11",
   "name": "D10 を外す（識別キーだけを有効に）",
   "find": "c.verdict = nonIdentity.length === 0 ? 'NO_CONTENT' : ",
   "replace": "c.verdict = nonIdentity.length === 0 ? 'VALID' : "
  },
  {
   "id": "M-12",
   "name": "重複で後の値を採用（X-2 違反）",
   "find": "if (!(x.k in fields)) fields[x.k] = valueOf(i);\n      else (dups[x.k] = dups[x.k] || []).push(valueOf(i));",
   "replace": "if (!(x.k in fields) || !x.dup) fields[x.k] = valueOf(i);\n      else (dups[x.k] = dups[x.k] || []).push(valueOf(i));"
  },
  {
   "id": "M-13",
   "name": "候補の closed を常に true と報告",
   "find": "closed: c.closed, keySet",
   "replace": "closed: true, keySet"
  },
  {
   "id": "M-14",
   "name": "余分な候補を報告",
   "find": "const diag = cands => cands.map(",
   "replace": "const diag = cands => cands.concat(cands.slice(0, 1)).map("
  },
  {
   "id": "M-15",
   "name": "keySet を1つ欠けて報告",
   "find": "keySet: c.keySet, placeholder",
   "replace": "keySet: (c.keySet || []).slice(1), placeholder"
  },
  {
   "id": "M-16",
   "name": "括弧の判定を外す",
