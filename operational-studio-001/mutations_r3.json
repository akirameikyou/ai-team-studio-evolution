   "replace": "const lineRe = new RegExp('(?:^|\\\\s)(' + keys.join('|') + ')\\\\s*:', 'gi');"
  },
  {
   "id": "M-19",
   "name": "ruleVersion を変える",
   "find": "const RULE_VERSION = 'v2';",
   "replace": "const RULE_VERSION = 'v2x';"
  },
